{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // ============================================================================
    // Target & module - Node.js 20+ native ESM
    // ============================================================================
    // ES2022 - top-level await, error.cause, Array.findLast etc.
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],

    // ============================================================================
    // Strict mode - bug-free code ke liye sab strict flags ON
    // Netflix/Airbnb codebases me ye sab on hote hai
    // ============================================================================
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,

    // ============================================================================
    // Emit
    // ============================================================================
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true,
    "declaration": false,
    "removeComments": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // ============================================================================
    // Path aliases - clean imports
    // import { logger } from "@/utils/logger" instead of "../../utils/logger"
    // ============================================================================
    // "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@db/*": ["./src/db/*"],
      "@lib/*": ["./src/lib/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@modules/*": ["./src/modules/*"],
      "@utils/*": ["./src/utils/*"],
      "@interfaces/*": ["./src/interfaces/*"],
      "@mails/*": ["./src/mails/*"],
      "@queues/*": ["./src/queues/*"],
      "@workers/*": ["./src/workers/*"]
    },

    // ============================================================================
    // Types
    // ============================================================================
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "server.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
