# ============================================================================
# .env.example - sare env vars ka template
# ============================================================================
# Copy karke .env banao: cp .env.example .env
# Production me secret manager (AWS/Doppler/Vault) se aate hai

# ===== APP =====
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# API versioning - frontend ke routes ke liye prefix
API_PREFIX=api
API_VERSION=v1

# ===== DATABASE =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# ===== REDIS (Upstash) =====
# Production: https://upstash.com dashboard
# Local: docker-compose me hiett/serverless-redis-http
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="example_token"

# ===== JWT =====
# Generate strong secrets: openssl rand -base64 64
JWT_ACCESS_SECRET="dev_change_me_to_64_char_random_secret_string_at_least_pls___1"
JWT_REFRESH_SECRET="dev_change_me_to_64_char_random_secret_string_at_least_pls___2"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ===== BCRYPT =====
BCRYPT_SALT_ROUNDS=12

# ===== CORS =====
# Comma separated multiple origins
CORS_ORIGIN="http://localhost:3000"

# ===== RATE LIMIT =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ===== SWAGGER DOCS =====
# Dev/staging me by default enabled hai
# Production me public docs chahiye to "true" set karo (Stripe-style)
# Internal API ke liye false rakho - leak prevention
ENABLE_DOCS=false

# ===== SENTRY (optional, production) =====
# SENTRY_DSN=
