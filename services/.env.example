# ============================================================================
# .env.example - All env vars template
# ============================================================================
# Copy: cp .env.example .env
# Production: secret manager (AWS Secrets Manager / Doppler / Vault)

# ===== APP =====
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

API_PREFIX=api
API_VERSION=v1
APP_URL=http://localhost:3000

# ===== DATABASE =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# ===== REDIS (ioredis - TCP) =====
# Upstash dashboard → "Connect" tab → "ioredis" → copy the rediss:// URL
# Format: rediss://default:<TOKEN>@<region>-<name>.upstash.io:6379
# Local dev (docker): redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ===== JWT =====
# Generate: openssl rand -base64 64
JWT_ACCESS_SECRET="dev_change_to_64_char_random_string_at_least_pls________________1"
JWT_REFRESH_SECRET="dev_change_to_64_char_random_string_at_least_pls________________2"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ===== BCRYPT =====
BCRYPT_SALT_ROUNDS=12

# ===== CORS =====
CORS_ORIGIN="http://localhost:3000"

# ===== COOKIES =====
# Subdomain sharing: ".shop.com" → cookie shared across admin.shop.com + www.shop.com
# Localhost / single domain: leave empty
# COOKIE_DOMAIN=.shop.com

# ===== RATE LIMIT =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ============================================================================
# EMAIL (SMTP)
# ============================================================================
# This project uses GMAIL SMTP for dev (free, no signup, real inbox).
#
# ----- HOW TO GET GMAIL APP PASSWORD (one-time setup, 2 min) -----
# Step 1: Enable 2-Factor Authentication on your Gmail account
#         https://myaccount.google.com/security
#         (App Passwords ONLY available after 2FA is on)
#
# Step 2: Generate App Password
#         https://myaccount.google.com/apppasswords
#         - "App name": E-Commerce Backend (any label)
#         - Click "Create"
#         - Copy the 16-character password (spaces don't matter)
#         - Example: "qcjj zvqf srgp tkpr"
#
# Step 3: Fill below
#         SMTP_USER  = your full gmail address (e.g. you@gmail.com)
#         SMTP_PASS  = the 16-char App Password (NOT your gmail login password)
#
# ----- IMPORTANT -----
# - App Password is NOT your Gmail account password
# - Regular gmail password WILL fail with 535 5.7.8 error
# - Keep the App Password secret - it bypasses 2FA
# - Revoke anytime from the apppasswords page
#
# ----- LIMITS (Gmail SMTP) -----
# - Free Gmail: ~500 sends/day
# - Workspace:  ~2000 sends/day
# - For production scale (>1000/day) - use AWS SES / Resend / Postmark
#
# ----- ALTERNATIVE PROVIDERS -----
# Mailtrap sandbox (fake inbox):
#   SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525  SMTP_SECURE=false
#   SMTP_USER=<from-mailtrap-dashboard>  SMTP_PASSWORD=<from-mailtrap-dashboard>
#   (leave SMTP_SERVICE empty)
#
# AWS SES SMTP (production):
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=<SES_SMTP_USER>  SMTP_PASSWORD=<SES_SMTP_PASS>
#
# Resend (modern API + SMTP):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=resend  SMTP_PASSWORD=<RESEND_API_KEY>
# ============================================================================

# Nodemailer service shortcut - auto-sets host/port for known providers
# Set to "gmail" for Gmail. Leave empty to use SMTP_HOST/PORT manually
SMTP_SERVICE=gmail

# Used as fallback when SMTP_SERVICE is empty
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Your Gmail address + App Password (NOT login password!)
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# "From" header - for Gmail must match SMTP_USER OR be a verified alias
# Format: "Display Name <email>"  OR just  "email"
EMAIL_FROM="E-Commerce <you@gmail.com>"
EMAIL_FROM_NAME="E-Commerce"

# ===== OBSERVABILITY =====
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ===== DOCS =====
# Production me public docs chahiye to true. Internal API ke liye false.
ENABLE_DOCS=true
