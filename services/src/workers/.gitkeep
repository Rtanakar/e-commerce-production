# workers/ - BullMQ workers (consumers) + Kafka consumers
#
# Files:
#   - email.worker.ts        (BullMQ email consumer)
#   - notification.worker.ts (push/SMS consumer)
#   - order-events.worker.ts (Kafka consumer)
