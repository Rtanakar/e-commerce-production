<!DOCTYPE html>
<html lang="en">

<head>
  <title>
    <%= title %>
  </title>
  <meta charset="UTF-8" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <style type="text/css">
    /* ---------- Reset ---------- */
    body,
    table,
    td,
    a {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    table,
    td {
      mso-table-lspace: 0;
      mso-table-rspace: 0;
    }

    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      outline: none;
      text-decoration: none;
    }

    /* ---------- Base ---------- */
    body {
      margin: 0;
      padding: 0;
      min-width: 100%;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      font-size: 15px;
      line-height: 1.65;
      background-color: #FFF7EC;
      color: #0E0A07;
    }

    /* ---------- Layout wrapper ---------- */
    .email-wrapper {
      max-width: 600px;
      margin: 40px auto;
      background-color: #FFFFFF;
      border: 1px solid #E6D6BD;
      border-radius: 12px;
      overflow: hidden;
    }

    /* ---------- Header ---------- */
    .email-header {
      background-color: #FF5A1F;
      padding: 28px 40px;
      color: #FFFFFF;
    }

    .email-header h1 {
      margin: 0;
      font-size: 22px;
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: -0.01em;
      color: #FFFFFF;
    }

    /* ---------- Body ---------- */
    .email-body {
      padding: 40px;
      background-color: #FFFFFF;
      color: #0E0A07;
    }

    .email-body h2 {
      margin: 0 0 16px;
      font-size: 24px;
      font-weight: 700;
      line-height: 1.3;
      color: #0E0A07;
    }

    .email-body p {
      margin: 0 0 16px;
      color: #3A2E22;
    }

    .email-body p.muted {
      color: #6B5B4A;
      font-size: 14px;
    }

    .email-body p.muted-sm {
      color: #6B5B4A;
      font-size: 13px;
      line-height: 1.6;
    }

    .email-body strong {
      color: #0E0A07;
    }

    /* ---------- OTP code box ---------- */
    .otp-box {
      display: inline-block;
      padding: 18px 36px;
      margin: 8px 0 24px;
      background-color: #FFF7EC;
      border: 2px solid #E6D6BD;
      border-radius: 10px;
      font-family: 'Courier New', monospace;
      font-size: 34px;
      font-weight: 700;
      letter-spacing: 10px;
      color: #0E0A07;
    }

    .otp-row {
      text-align: center;
      margin: 0 0 24px;
    }

    /* ---------- CTA button ---------- */
    .btn-row {
      margin: 8px 0 24px;
    }

    .btn {
      display: inline-block;
      padding: 14px 32px;
      background-color: #FF5A1F;
      color: #FFFFFF;
      text-decoration: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
    }

    /* ---------- URL fallback box ---------- */
    .url-box {
      margin: 0 0 24px;
      padding: 10px 12px;
      background-color: #FFF7EC;
      border: 1px solid #E6D6BD;
      border-radius: 6px;
      font-family: 'Courier New', monospace;
      color: #E04A12;
      font-size: 12px;
      word-break: break-all;
    }

    /* ---------- Footer ---------- */
    .email-footer {
      padding: 24px 40px;
      background-color: #F7EBD6;
      border-top: 1px solid #E6D6BD;
      color: #6B5B4A;
      font-size: 12px;
      line-height: 1.5;
      text-align: center;
    }

    .email-footer p {
      margin: 0 0 6px;
    }

    .email-footer p:last-child {
      margin: 0;
    }

    .email-footer a {
      color: #FF5A1F;
      text-decoration: none;
    }

    /* ---------- Preheader (hidden inbox preview) ---------- */
    .preheader {
      display: none;
      font-size: 1px;
      line-height: 1px;
      max-height: 0;
      max-width: 0;
      opacity: 0;
      overflow: hidden;
      color: #FFF7EC;
    }

    /* ---------- Mobile ---------- */
    @media screen and (max-width: 600px) {
      .email-wrapper {
        margin: 16px;
      }

      .email-header,
      .email-body,
      .email-footer {
        padding-left: 24px;
        padding-right: 24px;
      }

      .email-body {
        padding-top: 28px;
        padding-bottom: 28px;
      }

      .email-body h2 {
        font-size: 22px;
      }

      .otp-box {
        font-size: 28px;
        letter-spacing: 6px;
        padding: 14px 24px;
      }
    }
  </style>
</head>

<body>

  <div class="preheader">
    <%= preheader %>
  </div>

  <div class="email-wrapper">

    <div class="email-header">
      <h1>
        <%= brandName %>
      </h1>
    </div>

    <div class="email-body">
      <%- content %>
    </div>

    <div class="email-footer">
      <p>&copy; <%= year %>
          <%= brandName %>. All rights reserved.</p>
      <p>This is an automated message - please do not reply to this email.</p>
    </div>

  </div>

</body>

</html>